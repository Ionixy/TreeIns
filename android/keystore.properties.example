# Copy to android/keystore.properties and fill in. That file is gitignored — the real one
# must NEVER be committed.
#
# storeFile is resolved relative to the android/ directory. Keeping the .jks outside the
# repository entirely (an absolute path) is safer than keeping it next to the code.
storeFile=../../goaltree-release.jks
storePassword=CHANGE_ME
keyAlias=goaltree
keyPassword=CHANGE_ME
