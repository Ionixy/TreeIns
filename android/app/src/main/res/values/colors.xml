<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window backgrounds: same as the web app's --bg, so there's no flash of a
         different colour before the page paints. -->
    <color name="bg_light">#F2F2F7</color>   <!-- --bg (light), also manifest.json theme_color -->
    <color name="bg_dark">#000000</color>    <!-- --bg (dark) -->

    <!-- Adaptive-icon background. Must stay identical to the backdrop baked into
         mipmap-*/ic_launcher_foreground.png, which is full-bleed on top of it. -->
    <color name="icon_bg">#F8F8F8</color>
</resources>
