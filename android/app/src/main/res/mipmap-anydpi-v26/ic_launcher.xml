<?xml version="1.0" encoding="utf-8"?>
<!-- The foreground is full-bleed and painted in the SAME colour as the background, so no
     seam can appear whatever shape a launcher masks the icon to. The tree inside it sits
     within the 66/108dp safe circle every mask is guaranteed to keep. The monochrome layer
     is a silhouette: Android 13+ themed icons use only its alpha. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_bg" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
